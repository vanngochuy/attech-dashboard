      "typeVersion": 2.7,
      "position": [
        464,
        -96
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE document_files\nSET sync_status = 'missing_on_drive'\nWHERE id = '{{ $('Lấy danh sách file (Supabase)1').item.json.id }}';",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "fiEFomFKDWUZhAMd",
          "name": "Postgres account"
        }
      }
