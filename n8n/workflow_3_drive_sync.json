    {
      "id": "cd792239-45a6-45bd-8841-583d27e2d082",
      "name": "File đã bị xóa hoặc lỗi 404?1",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        240,
        -16
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "check-error",
              "leftValue": "={{ $json.trashed === true || ($json.error !== undefined && ($json.details?.httpCode === 404 || ($json.error?.message && $json.error.message.includes('404')))) }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": 1
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          }
        },
        "options": {}
      }
    },
    {
      "id": "24490d8a-ce13-408f-9896-5752732ac884",
