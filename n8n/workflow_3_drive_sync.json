{
  "name": "ATTECH - Scheduled & Manual Drive Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "1. Lập lịch mỗi đêm (00:00)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        -464,
        -96
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sync-drive-health",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-manual-sync",
      "name": "2. Webhook (Admin bấm Quét trên Web)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        -464,
        96
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, file_name, drive_file_id FROM document_files WHERE drive_file_id IS NOT NULL LIMIT 500;",
        "options": {}
      },
      "id": "pg-get-files",
      "name": "Lấy danh sách file (Supabase)1",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -208,
        -16
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://www.googleapis.com/drive/v3/files/{{ $json.drive_file_id }}?fields=id,name,trashed",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {}
      },
      "id": "gdrive-check",
      "name": "Kiểm tra file trên Google Drive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "onError": "continueRegularOutput",
      "position": [
        16,
        -16
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check-error-or-trashed",
              "leftValue": "={{ $json.error !== undefined || $json.trashed === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-error",
      "name": "File đã bị xóa hoặc lỗi 404?1",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        240,
        -16
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE document_files\nSET sync_status = 'missing_on_drive'\nWHERE id = '{{ $('Lấy danh sách file (Supabase)1').item.json.id }}';",
        "options": {}
      },
      "id": "pg-mark-warning",
      "name": "Đánh dấu Cảnh báo (Supabase)1",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        464,
        -96
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE document_files\nSET sync_status = 'synced'\nWHERE id = '{{ $('Lấy danh sách file (Supabase)1').item.json.id }}'\n  AND sync_status != 'synced';",
        "options": {}
      },
      "id": "pg-restore-synced",
      "name": "Khôi phục trạng thái Hợp lệ (Supabase)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        464,
        96
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, message: 'Hoàn tất quét đối soát toàn vẹn file Google Drive và Supabase' } }}",
        "options": {}
      },
      "id": "respond-sync",
      "name": "Phản hồi kết quả về Web",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        704,
        0
      ]
    }
  ],
